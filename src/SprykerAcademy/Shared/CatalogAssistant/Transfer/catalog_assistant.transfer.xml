<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!--
        Structured answer of the LLM. The property descriptions are instructions for the model:
        AiFoundation turns this transfer into a JSON schema and the model must answer in that shape.
        Every property must always be filled. AiFoundation rejects an answer with a null property,
        so the descriptions tell the model what to use when a value is unknown.
    -->
    <transfer name="ProductAnswer" strict="true">
        <property name="answer" type="string" description="The answer to the question of the customer, in the language of the question. Based only on the product details returned by the tools."/>
        <!--
            TODO-7: Add three more properties. Every description is an instruction for the model, so say what to return
            when the value is unknown, and that it is never null:
              - isInStock (bool): true when at least one variant is available, false otherwise or when the product was not found
              - confidence (string): 'high', 'medium', or 'low'; 'low' when the tools returned nothing useful
              - relatedSkus (string[], singular="relatedSku"): concrete SKUs that match the question best, an empty list when none apply
            Hint: property name="relatedSkus" type="string[]" singular="relatedSku"
        -->
    </transfer>

</transfers>
